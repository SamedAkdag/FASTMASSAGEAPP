# PingRing Environment Configuration Example
# Copy this file to .env and fill in your actual values

# ntfy.sh topic prefix for the application
# Used for cloud relay messaging between devices
NTFY_TOPIC_PREFIX=pingring

# Application identifier
APP_ID=com.aistudio.pingring.pgrng

# Feature flags
ENABLE_CLOUD_RELAY=true
ENABLE_LOCAL_PAIRING=true
